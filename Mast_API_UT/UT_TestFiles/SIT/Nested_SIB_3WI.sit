CHAIN Nested_SIB_3WI
{
  SIB SIB1 POST HIGH
  (
    CHAIN SIB1_1 NOT_IN_PATH
    {
      INSTANCE WI1 OF WrappedInstr.sit
      SIB SIB2 POST HIGH
      (
        CHAIN SIB2_1 NOT_IN_PATH
        {
          INSTANCE WI2 OF WrappedInstr.sit
          SIB SIB3 POST HIGH
          (
            INSTANCE WI3 OF WrappedInstr.sit
          )
        }
      )
    }
  )
}

