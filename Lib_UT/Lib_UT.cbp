<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="Lib_UT" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="../bin/Debug/Lib_UT" prefix_auto="1" extension_auto="1" />
				<Option object_output="../obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="| mtee ..\..\Lib_UT\UT_Results\UT_Result.txt" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="../bin/Debug/libLib.a" />
				</Linker>
				<ExtraCommands>
					<Add before="mingw32-make.exe -f runner.mak" />
				</ExtraCommands>
			</Target>
			<Target title="Release">
				<Option output="../bin/Release/Lib_UT" prefix_auto="1" extension_auto="1" />
				<Option object_output="../obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="--display_success | mtee ..\..\Lib_UT\UT_Results\UT_Result.txt" />
				<Option projectIncludeDirsRelation="0" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add library="../bin/Release/libLib.a" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wnon-virtual-dtor" />
			<Add option="-Wshadow" />
			<Add option="-Winit-self" />
			<Add option="-Wredundant-decls" />
			<Add option="-Wcast-align" />
			<Add option="-Wundef" />
			<Add option="-Wfloat-equal" />
			<Add option="-Winline" />
			<Add option="-Wunreachable-code" />
			<Add option="-Wmissing-declarations" />
			<Add option="-Wmissing-include-dirs" />
			<Add option="-Wswitch-enum" />
			<Add option="-Wswitch-default" />
			<Add option="-Weffc++" />
			<Add option="-Wmain" />
			<Add option="-pedantic-errors" />
			<Add option="-pedantic" />
			<Add option="-w" />
			<Add option="-Wfatal-errors" />
			<Add option="-Wextra" />
			<Add option="-fexceptions" />
			<Add option="-DCXXTEST_HAVE_EH" />
			<Add option="-DCXXTEST_HAVE_STD" />
			<Add option="-DCXXTEST_PARTIAL_TEMPLATE_SPECIALIZATION" />
			<Add directory="../cxxtest" />
			<Add directory="../Lib/include" />
			<Add directory="../Lib/public_include" />
			<Add directory="CxxTest_Traits" />
		</Compiler>
		<Unit filename="CxxTest_Traits/BinaryVector_Traits.hpp" />
		<Unit filename="Generated/Runner.cpp" />
		<Unit filename="Utility/UT_BinaryVector.cpp" />
		<Unit filename="Utility/UT_BinaryVector.hpp">
			<Option target="&lt;{~None~}&gt;" />
		</Unit>
		<Extensions>
			<code_completion>
				<search_path add="..\cxxtest" />
			</code_completion>
			<envvars />
			<debugger />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
